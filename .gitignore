# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ── Portfolio Studio: private data (never commit) ──────────────
# Private vault: Obyektivka fields, relatives, private contacts, review notes
/content/private.json
/content/*.tmp
# Private files: Obyektivka photo, private uploads, source documents
/private/
# Source documents (resume / obyektivka PDFs) kept at the repo root
/*.pdf
/*.docx
